# ---- Server ----
PORT=4000
# Where the React app runs (used for CORS). Vite dev default is 5173.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Reverse proxy ----
# Number of proxy hops in front of the API. Leave unset for local/direct use.
# Behind a platform proxy (Render, etc.) set 1 so req.ip — and rate limiting —
# reflects the real client instead of the proxy. Do NOT enable when the API is
# reachable directly, or clients could spoof their address via X-Forwarded-For.
# TRUST_PROXY=1

# ---- Rate limiting store (optional) ----
# Unset: counters live in this process (fine for a single instance, but they
# reset on restart and are not shared across instances). Set to a Redis URL
# (redis:// or rediss:// for TLS) once the API runs on more than one instance
# so limits are shared and restart-proof.
# REDIS_URL=redis://localhost:6379

# ---- Session cookies ----
# 'lax' works when the SPA and API share a site (including the Vite proxy).
# Use 'none' only if the API is on a different site than the SPA; that also
# requires HTTPS (Secure), i.e. production.
COOKIE_SAMESITE=lax
# Optional: restrict cookies to a parent domain, e.g. .example.com
# COOKIE_DOMAIN=

# ---- Supabase ----
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon public" key. Safe-ish (RLS-gated); used here only for auth sign-in / refresh.
SUPABASE_ANON_KEY=your-anon-public-key

# "service_role" key. FULL ACCESS, bypasses RLS. SERVER ONLY.
# Never put this in the React app, a VITE_ variable, or version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Razorpay (optional) ----
# Leave unset to boot without payments; /payments routes then answer 503.
# Dashboard -> Account & Settings -> API Keys. Only KEY_ID reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks (event: payment.captured / payment.failed). Signs the
# raw request body. SERVER ONLY.
RAZORPAY_WEBHOOK_SECRET=

# Minutes an unpaid checkout may hold reserved stock before the sweeper expires
# the payment and releases it. Defaults to 5. Dismissing the Razorpay modal
# releases stock immediately regardless.
PAYMENT_EXPIRY_MINUTES=5
