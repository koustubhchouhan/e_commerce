# ---- Server ----
PORT=4000
# Where the React app runs (used for CORS). Vite dev default is 5173.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Supabase ----
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon public" key. Safe-ish (RLS-gated); used here only for auth sign-in / refresh.
SUPABASE_ANON_KEY=your-anon-public-key

# "service_role" key. FULL ACCESS, bypasses RLS. SERVER ONLY.
# Never put this in the React app, a VITE_ variable, or version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
