# Vite environment (frontend)
# Leave unset in dev to use the Vite proxy (/api -> http://localhost:4000).
# Set to the absolute API base URL when the frontend is served separately.
VITE_API_URL=

# Google sign-in (optional).
# The ANON key is public by design and only lets the browser run the user's own
# OAuth login. Enable the Google provider in Supabase (Auth -> Providers), then
# add this app's /auth/callback URL to the redirect allowlist.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
